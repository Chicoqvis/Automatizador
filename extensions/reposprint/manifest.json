{
  "manifest_version": 3,
  "name": "Automatizador · RepoSprint",
  "version": "0.5.5",
  "description": "Busca issues e permite adicioná-las ao backlog usando o RepoSprint aberto no navegador.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://reposprint.com/*",
    "https://api.reposprint.com/*",
    "https://automacao-issues-ai.automacao-issue-chico.workers.dev/*"
  ],
  "action": {
    "default_title": "Adicionar ao RepoSprint",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://automacao-issues-ai.automacao-issue-chico.workers.dev/*"
      ],
      "js": [
        "tool.js",
        "process-bridge.js"
      ]
    }
  ]
}